# Copy to .env for local development (npm run dev loads it automatically)
NODE_ENV=development
LOG_LEVEL=info

MONGO_URL=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379

# MUST be changed in production (services refuse to start with the default)
JWT_SECRET=dev-secret-change-me
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=2592000

# Service discovery (gateway -> upstreams)
GATEWAY_PORT=8080
AUTH_URL=http://localhost:4001
LOBBY_URL=http://localhost:4002
GAME_URL=http://localhost:4003
STATS_URL=http://localhost:4004
LEAGUE_URL=http://localhost:4005
REWARDS_URL=http://localhost:4006

AUTH_PORT=4001
LOBBY_PORT=4002
GAME_PORT=4003
STATS_PORT=4004
LEAGUE_PORT=4005
REWARDS_PORT=4006

# Gameplay
TURN_TIMEOUT_MS=20000     # a human who does not act in time is auto-played; 3 misses in a row = forfeit
BOT_DELAY_MS=900          # "thinking time" before a bot acts

# Matchmaking
MM_BOTS=on                # on | off - fill empty seats with bots when nobody suitable is found
MM_BOT_FILL_SEC=10        # how long a player waits before bots are added
MM_MAX_WAIT_SEC=60        # only used when MM_BOTS=off: give up after this long
